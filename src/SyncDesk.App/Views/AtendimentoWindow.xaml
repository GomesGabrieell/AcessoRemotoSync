<Window x:Class="SyncDesk.Views.AtendimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource Janela}" Title="SyncDesk" WindowStartupLocation="CenterScreen"
        Width="680" Height="650" MinWidth="460" MinHeight="420">
    <Grid>
        <web:WebView2 x:Name="Conteudo" Visibility="Hidden" />
        <Border x:Name="PainelDeEstado" Style="{StaticResource Cartao}" Margin="24" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SyncDesk" Style="{StaticResource Titulo}" />
                <TextBlock x:Name="Estado" Text="Abrindo o atendimento…" Style="{StaticResource Apoio}" Margin="0,8,0,0" />
                <Button x:Name="TentarNovamente" Content="Tentar novamente" HorizontalAlignment="Left"
                        Style="{StaticResource Primario}" Click="Recarregar" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
