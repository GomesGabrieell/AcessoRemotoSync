<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SyncDesk</AssemblyName>
    <RootNamespace>SyncDesk</RootNamespace>
    <Product>SyncDesk</Product>
    <Description>SyncDesk — suporte remoto</Description>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <SyncDeskServerUrl Condition="'$(SyncDeskServerUrl)' == ''">https://localhost:7443</SyncDeskServerUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <AssemblyMetadata Include="SyncDeskServerUrl" Value="$(SyncDeskServerUrl)" />
    <EmbeddedResource Include="../SyncDesk.Sinalizacao/wwwroot/*" LogicalName="Painel.%(Filename)%(Extension)" />
    <ProjectReference Include="../SyncDesk.Infrastructure/SyncDesk.Infrastructure.csproj" />
  </ItemGroup>
</Project>
